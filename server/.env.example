# Copy this file to .env and fill in real values.
# Never commit the real .env file — it's already in .gitignore.

# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The first admin account is created from these on first run only.
# Pick a real username/password you control — this is a real login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# development | production
FLASK_ENV=development
PORT=5050

# Only set this if the frontend is hosted on a different domain than this
# API (e.g. frontend on Netlify, this backend on Render). Leave blank if
# they're served from the same origin.
ALLOWED_ORIGIN=
